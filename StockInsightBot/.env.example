# StockInsightBot 环境变量配置模板
# 复制此文件为 .env 并填入您的真实配置

# ===========================================
# Telegram Bot 配置
# ===========================================
# 从 @BotFather 获取的 Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ===========================================
# OpenAI API 配置
# ===========================================
# OpenAI API Key
OPENAI_API_KEY=your_openai_api_key_here

# OpenAI 模型选择 (可选，默认 gpt-4o)
OPENAI_MODEL=gpt-4o

# OpenAI API Base URL (可选，用于代理或兼容 API)
# OPENAI_API_BASE=https://api.openai.com/v1

# ===========================================
# 数据缓存配置 (可选)
# ===========================================
# 缓存过期时间（秒），默认 300 秒
CACHE_TTL=300

# 最大缓存条目数，默认 100
CACHE_MAX_SIZE=100

# ===========================================
# 日志配置 (可选)
# ===========================================
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 日志文件路径 (留空则仅输出到控制台)
LOG_FILE=

# ===========================================
# 其他配置 (可选)
# ===========================================
# 报告最大长度（字符数），超出将分段发送
MAX_MESSAGE_LENGTH=4000

# 单次新闻获取数量
NEWS_LIMIT=5
