# Aster / Binance Futures API Credentials
ASTER_API_KEY=your_api_key_here
ASTER_API_SECRET=your_api_secret_here

# Trading Mode: "paper" for simulation, "live" for real trading
TRADING_MODE=paper

# Optional: Custom Aster API endpoint (leave empty to use default Binance futures)
# ASTER_API_URL=https://pro-api.asterdex.com

# Dashboard settings
# DASHBOARD_PORT=8080
