[Unit]
 Description=Stock bot project setup
 After=network-online.target
 Wants=network-online.target

[Service]
 Type=simple
 WorkingDirectory=/opt/stock-bot
 EnvironmentFile=/etc/stock-bot.env
 ExecStart=/usr/bin/python3 /opt/stock-bot/bot.py
 Restart=always
 RestartSec=5

[Install]
 WantedBy=multi-user.target
